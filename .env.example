# Copy to .env.development.local (local Docker database) and fill in.
# Placeholders only. Never commit real values.

# PostgreSQL. Locally both point at the Docker database from docker-compose.yml.
# On Neon: DATABASE_URL = pooled connection string, DIRECT_URL = direct connection string.
DATABASE_URL="postgresql://jansetu:jansetu@localhost:5433/jansetu?schema=public"
DIRECT_URL="postgresql://jansetu:jansetu@localhost:5433/jansetu?schema=public"

# Session signing key. Required, at least 32 characters. Generate: openssl rand -base64 48
JWT_SECRET=""

# Optional: Google AI Studio key for the vision model. Without it the app uses keyword rules only.
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.5-flash"

# Optional: Vercel Blob token (set automatically on Vercel when a Blob store is linked).
# Without it, uploads are written to the local .uploads/ folder (development only).
BLOB_READ_WRITE_TOKEN=""

# Used only by `npm run seed:prod` to create the first accounts.
SEED_ADMIN_PASSWORD=""
SEED_OFFICER_PASSWORD=""
SEED_CITIZEN_PASSWORD=""

# Contact address sent in the User-Agent of reverse-geocoding requests (OpenStreetMap policy).
GEOCODER_CONTACT=""
