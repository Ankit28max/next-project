generator client {
  provider = "prisma-client-js"
}

// DATABASE_URL = pooled connection (used by the app at runtime).
// DIRECT_URL   = direct connection (used by `prisma migrate`, which cannot run through a pooler).
datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  CITIZEN
  OFFICER
  ADMIN
}

enum ComplaintStatus {
  SUBMITTED
  UNDER_REVIEW
  ASSIGNED
  IN_PROGRESS
  AWAITING_CITIZEN_RESPONSE
  RESOLVED
  REJECTED
  REOPENED
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum FraudRiskLevel {
  LOW
  MEDIUM
  HIGH
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  phone        String?
  role         Role     @default(CITIZEN)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  officerProfile       OfficerProfile?
  complaintsSubmitted  Complaint[]              @relation("CitizenComplaints")
  uploadedImages       ComplaintImage[]
  statusHistoryEntries ComplaintStatusHistory[]
  notifications        Notification[]
  auditLogs            AuditLog[]

  @@index([role])
}

model Department {
  id          String   @id @default(cuid())
  code        String   @unique
  name        String
  description String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  officers     OfficerProfile[]
  complaints   Complaint[]
  categories   ComplaintCategory[]
  routingRules RoutingRule[]
}

model OfficerProfile {
  id           String   @id @default(cuid())
  userId       String   @unique
  departmentId String
  employeeId   String   @unique
  designation  String?
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user               User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  department         Department  @relation(fields: [departmentId], references: [id])
  complaintsAssigned Complaint[]

  @@index([departmentId])
}

model ComplaintCategory {
  id                  String   @id @default(cuid())
  code                String   @unique
  name                String
  description         String
  defaultDepartmentId String?
  defaultPriority     Priority @default(MEDIUM)
  active              Boolean  @default(true)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  defaultDepartment Department? @relation(fields: [defaultDepartmentId], references: [id])
  complaints        Complaint[]
}

model Complaint {
  id                String          @id @default(cuid())
  referenceNumber   String          @unique
  citizenId         String
  title             String
  description       String          @db.Text
  categoryId        String?
  departmentId      String?
  assignedOfficerId String?
  status            ComplaintStatus @default(SUBMITTED)
  priority          Priority        @default(MEDIUM)
  address           String          @db.Text
  latitude          Float
  longitude         Float
  urgencyDeclared   Boolean         @default(false)
  consentGiven      Boolean         @default(false)

  // Summary of the latest analysis (details live in ComplaintAnalysis).
  // fraudRiskLevel stays NULL when the analysis could not run; see needsManualTriage.
  duplicateScore    Float?
  fraudRiskScore    Int?
  fraudRiskLevel    FraudRiskLevel?
  needsManualTriage Boolean         @default(false)
  triageReason      String?

  resolutionSummary String?   @db.Text
  resolvedAt        DateTime?
  reopenedAt        DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  citizen         User               @relation("CitizenComplaints", fields: [citizenId], references: [id])
  category        ComplaintCategory? @relation(fields: [categoryId], references: [id])
  department      Department?        @relation(fields: [departmentId], references: [id])
  assignedOfficer OfficerProfile?    @relation(fields: [assignedOfficerId], references: [id])

  images          ComplaintImage[]
  statusHistory   ComplaintStatusHistory[]
  analyses        ComplaintAnalysis[]
  matchesAsSource ComplaintMatch[]         @relation("SourceMatches")
  matchesAsTarget ComplaintMatch[]         @relation("TargetMatches")
  notifications   Notification[]

  @@index([citizenId])
  @@index([departmentId, status])
  @@index([assignedOfficerId])
  @@index([createdAt])
  @@index([latitude, longitude])
}

// A photo is uploaded BEFORE the complaint exists, so complaintId starts NULL
// and is filled in when the uploader submits the complaint.
// Everything here is computed by the server from the real bytes.
model ComplaintImage {
  id          String   @id @default(cuid())
  uploaderId  String
  complaintId String?
  storageUrl  String
  mimeType    String
  fileSize    Int
  width       Int
  height      Int
  imageHash   String // 64-bit dHash as 16 hex characters
  // Facts read from EXIF before it was stripped (raw EXIF is never stored).
  hasExif      Boolean   @default(false)
  exifTakenAt  DateTime?
  exifLat      Float?
  exifLng      Float?
  exifDevice   String?
  exifSoftware String?
  uploadedAt   DateTime  @default(now())

  uploader  User       @relation(fields: [uploaderId], references: [id], onDelete: Cascade)
  complaint Complaint? @relation(fields: [complaintId], references: [id], onDelete: Cascade)

  @@index([complaintId])
  @@index([uploaderId])
}

model ComplaintStatusHistory {
  id             String          @id @default(cuid())
  complaintId    String
  actorId        String?
  previousStatus ComplaintStatus
  newStatus      ComplaintStatus
  remarks        String?         @db.Text
  isInternal     Boolean         @default(false)
  createdAt      DateTime        @default(now())

  complaint Complaint @relation(fields: [complaintId], references: [id], onDelete: Cascade)
  actor     User?     @relation(fields: [actorId], references: [id])

  @@index([complaintId])
}

model ComplaintAnalysis {
  id            String @id @default(cuid())
  complaintId   String
  // Which classifier actually produced the category: "rules" or "gemini".
  provider      String
  modelName     String
  categoryCode  String
  // Sum of matched keyword weights. NOT a probability.
  ruleMatchStrength          Int
  severity                   Priority
  imageMatchesText           Boolean?
  looksLikeStockOrScreenshot Boolean?
  classificationReasons      Json
  // Why the vision model was not used (missing key, timeout, invalid output...). NULL when it was.
  fallbackReason String?
  fraudRiskScore Int
  fraudRiskLevel FraudRiskLevel
  fraudReasons   Json
  routingReason  String   @db.Text
  createdAt      DateTime @default(now())

  complaint Complaint @relation(fields: [complaintId], references: [id], onDelete: Cascade)

  @@index([complaintId])
}

model ComplaintMatch {
  id                 String   @id @default(cuid())
  complaintId        String
  matchedComplaintId String
  textSimilarity     Float
  imageSimilarity    Float?
  distanceMeters     Int
  combinedScore      Float
  reasons            Json
  createdAt          DateTime @default(now())

  complaint        Complaint @relation("SourceMatches", fields: [complaintId], references: [id], onDelete: Cascade)
  matchedComplaint Complaint @relation("TargetMatches", fields: [matchedComplaintId], references: [id], onDelete: Cascade)

  @@index([complaintId])
  @@index([matchedComplaintId])
}

model Notification {
  id          String    @id @default(cuid())
  userId      String
  complaintId String?
  title       String
  message     String    @db.Text
  readAt      DateTime?
  createdAt   DateTime  @default(now())

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  complaint Complaint? @relation(fields: [complaintId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  action     String
  entityType String
  entityId   String?
  metadata   Json?
  createdAt  DateTime @default(now())

  actor User? @relation(fields: [actorId], references: [id])

  @@index([createdAt])
  @@index([action])
}

// Admin-editable routing: if any keyword appears (as a whole word) in the complaint text,
// the complaint goes to this department. Lower `position` is checked first.
model RoutingRule {
  id           String   @id @default(cuid())
  keywords     String // comma-separated
  departmentId String
  position     Int      @default(100)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())

  department Department @relation(fields: [departmentId], references: [id])

  @@index([active, position])
}
