{
  "name": "jansetu",
  "version": "1.0.0",
  "private": true,
  "description": "JanSetu: a civic grievance portal with advisory AI triage (academic project, INT257).",
  "engines": {
    "node": ">=20.6"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "vercel-build": "prisma migrate deploy && next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "eval": "tsx --env-file-if-exists=.env.local scripts/eval.ts",
    "postinstall": "prisma generate",
    "db:up": "docker compose up -d db",
    "db:migrate": "node --env-file=.env.development.local node_modules/prisma/build/index.js migrate dev",
    "db:studio": "node --env-file=.env.development.local node_modules/prisma/build/index.js studio",
    "seed:demo": "tsx --env-file=.env.development.local prisma/seed.ts",
    "seed:prod": "tsx --env-file=.env.local prisma/seed-production.ts",
    "eval:images": "tsx scripts/make-eval-images.ts"
  },
  "dependencies": {
    "@prisma/client": "^5.21.1",
    "@vercel/blob": "^2.9.0",
    "bcryptjs": "^2.4.3",
    "clsx": "^2.1.1",
    "exifr": "^7.1.3",
    "jose": "^6.2.17",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.453.0",
    "next": "~14.2.35",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sharp": "^0.35.5",
    "tailwind-merge": "^2.5.4",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/leaflet": "^1.9.14",
    "@types/node": "^20.16.11",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.4.20",
    "eslint": "^8.57.1",
    "eslint-config-next": "~14.2.35",
    "postcss": "^8.4.47",
    "prisma": "^5.21.1",
    "tailwindcss": "^3.4.14",
    "tsx": "^4.23.15",
    "typescript": "^5.6.3",
    "vitest": "^2.1.3"
  }
}
