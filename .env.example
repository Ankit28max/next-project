# ========================================================
# SMART GRIEVANCE REDRESSAL & FAKE COMPLAINT DETECTION SYSTEM
# Environment Configuration Template
# ========================================================

# Application URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"

# Relational Database Connection (PostgreSQL)
# Format: postgresql://[user]:[password]@[host]:[port]/[database]?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/grievance_db?schema=public"

# Authentication Security (JWT Session)
# Generate a secure 32+ character random string in production
JWT_SECRET="academic-demo-jwt-secret-key-super-secure-min-32-chars-2026"
JWT_EXPIRES_IN="7d"

# AI Provider Configuration
# Options: "mock" (offline, deterministic, no API key needed) | "gemini" | "openai"
AI_PROVIDER="mock"

# Optional Live AI Keys (Only needed if AI_PROVIDER is set to "gemini" or "openai")
GEMINI_API_KEY=""
OPENAI_API_KEY=""

# File Upload Configuration
UPLOAD_DIR="public/uploads"
MAX_UPLOAD_SIZE_MB="5"
ALLOWED_MIME_TYPES="image/jpeg,image/png,image/webp,image/jpg"

# Duplicate Detection Tuning Parameters
DUPLICATE_RADIUS_KM="2.0"
DUPLICATE_THRESHOLD="0.65"

# Suspicious / Fraud Risk Tuning Parameters
FRAUD_ALERT_THRESHOLD="60"
