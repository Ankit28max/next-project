generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  CITIZEN
  OFFICER
  ADMIN
}

enum ComplaintStatus {
  SUBMITTED
  UNDER_REVIEW
  ASSIGNED
  IN_PROGRESS
  AWAITING_CITIZEN_RESPONSE
  RESOLVED
  REJECTED
  REOPENED
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum FraudRiskLevel {
  LOW
  MEDIUM
  HIGH
}

model User {
  id            String    @id @default(cuid())
  name          String
  email         String    @unique
  passwordHash  String
  phone         String?
  role          Role      @default(CITIZEN)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  officerProfile       OfficerProfile?
  complaintsSubmitted  Complaint[]             @relation("CitizenComplaints")
  statusHistoryEntries ComplaintStatusHistory[]
  notifications        Notification[]
  auditLogs            AuditLog[]

  @@index([email])
  @@index([role])
}

model Department {
  id           String             @id @default(cuid())
  code         String             @unique
  name         String
  description  String
  jurisdiction String?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  officers     OfficerProfile[]
  complaints   Complaint[]
  categories   ComplaintCategory[]
  routingRules RoutingRule[]

  @@index([code])
}

model OfficerProfile {
  id           String      @id @default(cuid())
  userId       String      @unique
  departmentId String
  employeeId   String      @unique
  badgeNumber  String?
  designation  String?
  active       Boolean     @default(true)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  user         User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  department   Department  @relation(fields: [departmentId], references: [id])
  complaintsAssigned Complaint[]

  @@index([userId])
  @@index([departmentId])
  @@index([employeeId])
}

model ComplaintCategory {
  id                  String       @id @default(cuid())
  code                String       @unique
  name                String
  description         String
  defaultDepartmentId String?
  defaultPriority     Priority     @default(MEDIUM)
  active              Boolean      @default(true)
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt

  defaultDepartment   Department?  @relation(fields: [defaultDepartmentId], references: [id])
  complaints          Complaint[]
  routingRules        RoutingRule[]

  @@index([code])
}

model Complaint {
  id                 String           @id @default(cuid())
  referenceNumber    String           @unique
  citizenId          String
  title              String
  description        String           @db.Text
  categoryId         String?
  departmentId       String?
  assignedOfficerId  String?
  status             ComplaintStatus  @default(SUBMITTED)
  priority           Priority         @default(MEDIUM)
  address            String           @db.Text
  latitude           Float?
  longitude          Float?
  urgencyDeclared    Boolean          @default(false)
  consentGiven       Boolean          @default(true)
  
  // AI Analysis Cache & Metrics
  aiCategory         String?
  aiConfidence       Float?
  aiExplanation      String?          @db.Text
  duplicateScore     Float?
  fraudRiskScore     Float?
  fraudRiskLevel     FraudRiskLevel?
  
  // Resolution details
  resolutionSummary  String?          @db.Text
  resolvedAt         DateTime?
  reopenedAt         DateTime?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  citizen            User             @relation("CitizenComplaints", fields: [citizenId], references: [id])
  category           ComplaintCategory? @relation(fields: [categoryId], references: [id])
  department         Department?      @relation(fields: [departmentId], references: [id])
  assignedOfficer    OfficerProfile?  @relation(fields: [assignedOfficerId], references: [id])
  
  images             ComplaintImage[]
  statusHistory      ComplaintStatusHistory[]
  analyses           ComplaintAnalysis[]
  matchesAsSource    ComplaintMatch[] @relation("SourceMatches")
  matchesAsTarget    ComplaintMatch[] @relation("TargetMatches")
  notifications      Notification[]

  @@index([referenceNumber])
  @@index([citizenId])
  @@index([departmentId])
  @@index([assignedOfficerId])
  @@index([status])
  @@index([priority])
  @@index([fraudRiskLevel])
  @@index([createdAt])
}

model ComplaintImage {
  id                 String    @id @default(cuid())
  complaintId        String
  storageUrl         String
  fileName           String
  mimeType           String
  fileSize           Int
  imageHash          String?
  embeddingReference String?
  uploadedAt         DateTime  @default(now())

  complaint          Complaint @relation(fields: [complaintId], references: [id], onDelete: Cascade)

  @@index([complaintId])
  @@index([imageHash])
}

model ComplaintStatusHistory {
  id             String          @id @default(cuid())
  complaintId    String
  actorId        String?
  previousStatus ComplaintStatus
  newStatus      ComplaintStatus
  remarks        String?         @db.Text
  isInternal     Boolean         @default(false)
  createdAt      DateTime        @default(now())

  complaint      Complaint       @relation(fields: [complaintId], references: [id], onDelete: Cascade)
  actor          User?           @relation(fields: [actorId], references: [id])

  @@index([complaintId])
  @@index([actorId])
  @@index([createdAt])
}

model ComplaintAnalysis {
  id                String          @id @default(cuid())
  complaintId       String
  modelProvider     String
  modelVersion      String
  predictedCategory String
  confidence        Float
  duplicateScore    Float
  fraudRiskScore    Float
  fraudRiskLevel    FraudRiskLevel
  explanation       String          @db.Text
  rawResult         Json?
  createdAt         DateTime        @default(now())

  complaint         Complaint       @relation(fields: [complaintId], references: [id], onDelete: Cascade)

  @@index([complaintId])
  @@index([createdAt])
}

model ComplaintMatch {
  id                 String    @id @default(cuid())
  complaintId        String
  matchedComplaintId String
  textSimilarity     Float
  imageSimilarity    Float
  geographicDistance Float
  combinedScore      Float
  matchReason        String    @db.Text
  createdAt          DateTime  @default(now())

  complaint          Complaint @relation("SourceMatches", fields: [complaintId], references: [id], onDelete: Cascade)
  matchedComplaint   Complaint @relation("TargetMatches", fields: [matchedComplaintId], references: [id], onDelete: Cascade)

  @@index([complaintId])
  @@index([matchedComplaintId])
}

model Notification {
  id          String     @id @default(cuid())
  userId      String
  complaintId String?
  title       String
  message     String     @db.Text
  type        String     @default("STATUS_CHANGE")
  readAt      DateTime?
  createdAt   DateTime   @default(now())

  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  complaint   Complaint? @relation(fields: [complaintId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([complaintId])
  @@index([readAt])
}

model AuditLog {
  id         String    @id @default(cuid())
  actorId    String?
  action     String
  entityType String
  entityId   String?
  metadata   Json?
  ipAddress  String?
  createdAt  DateTime  @default(now())

  actor      User?     @relation(fields: [actorId], references: [id])

  @@index([actorId])
  @@index([action])
  @@index([entityType])
  @@index([createdAt])
}

model RoutingRule {
  id           String            @id @default(cuid())
  categoryId   String?
  keywords     String
  departmentId String
  priority     Priority          @default(MEDIUM)
  active       Boolean           @default(true)
  createdAt    DateTime          @default(now())

  category     ComplaintCategory? @relation(fields: [categoryId], references: [id])
  department   Department        @relation(fields: [departmentId], references: [id])

  @@index([departmentId])
  @@index([categoryId])
}
